[Unit]
Description=Ethereum PostgreSQL interaction-pair indexer
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=crystal-clear-prod
Group=crystal-clear-prod
WorkingDirectory=/home/crystal-clear-prod/crystal-clear/webapp/backend/tools/ethereum-neo4j-indexer
EnvironmentFile=/etc/eth-graph-indexer.env
Environment=INDEXER_DATABASE_URL=postgresql:///cc
ExecStart=/home/crystal-clear-prod/crystal-clear/webapp/backend/tools/ethereum-neo4j-indexer/.venv/bin/eth-graph-indexer ingest \
  --trace-mode trace_block \
  --concurrent-blocks 1 \
  --resume true \
  --follow true \
  --poll-interval 12
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
