#!/bin/bash
# Send stdin to Telegram via the existing mevgo ops bot (runs as martin, who
# owns the token). Never fails the caller.
msg=$(cat)
[ -n "$msg" ] || exit 0
logger -t cc-notify -p daemon.warning -- "$msg"
runuser -u martin -- /home/martin/bin/mevgo-tg-notify.sh <<<"$msg" >/dev/null 2>&1 || true
